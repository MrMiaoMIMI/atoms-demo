# DeepSeek (OpenAI-compatible). Leave LLM_API_KEY empty to run the Mock Agent.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=180
# Reviewer 发现问题时自动让 Coder 回修
AUTO_REPAIR=1

# Generated project runtime
# 同时运行的生成项目后端数量（LRU 淘汰）
MAX_RUNNING_APPS=2
# 单个生成后端的内存上限（Linux RLIMIT_AS，0 表示不限制）
GENERATED_APP_MEMORY_MB=256
# 生成后端启动等待秒数
RUNTIME_START_TIMEOUT=20
# 预览构建超时秒数
FRONTEND_BUILD_TIMEOUT=120

# Optional overrides
# DATA_DIR=/app/data
# PREVIEW_NODE_MODULES=/opt/preview/node_modules
