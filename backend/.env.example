# DeepSeek (OpenAI-compatible). Leave LLM_API_KEY empty for Mock demo mode:
# the workflow still runs end-to-end, but generates a neutral placeholder page
# instead of pretending to build the requested app.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=180
# 生成调用失败后的重试策略：默认首次失败后再重试 3 次（共 4 次尝试）
LLM_MAX_RETRIES=3
# 重试退避：1s、2s、4s…（上限 8s）
LLM_RETRY_BACKOFF=1.0
LLM_RETRY_BACKOFF_MAX=8.0
# 单次请求输出 token 预算；上游若返回 400 会自动降回 8192
LLM_MAX_TOKENS=16384
# 输出被 finish_reason=length 截断时，最多续写几次（含首次请求）
LLM_CONTINUATION_PASSES=3
# 大文件守卫：超过 12000 字符告警；超过 20000 字符的前端 TS/TSX 尝试自动拆分
FILE_SIZE_WARN_CHARS=12000
FILE_SIZE_SPLIT_CHARS=20000
FILE_SPLIT_MAX_FILES=8
# 设为 0 可关闭自动拆分
# FILE_SPLIT=0
# Reviewer 发现问题时自动让 Coder 回修
AUTO_REPAIR=1
# 首次构建成功后的视觉打磨：只改 frontend/src/App.tsx、styles.css、
# components/**、pages/**；失败会回退并保留功能版本。设为 0 可关闭。
DESIGN_PASS_FIRST_BUILD=1
DESIGN_PASS_MAX_STEPS=16
DESIGN_PASS_SECONDS=420
DESIGN_PASS_MAX_TOOL_CALLS=120

# Agent tool loop（统一首建与迭代）
# 设为 0 时回退到旧的一次性整文件生成链路（provider 不支持 tools 时使用）
AGENT_TOOL_LOOP=1
# 工具循环步数上限（按计划文件数动态计算，这里是硬上限）
AGENT_MAX_STEPS_FIRST_BUILD=96
AGENT_MAX_STEPS_ITERATION=64
# 单轮墙钟上限（秒）
AGENT_MAX_SECONDS_FIRST_BUILD=1200
AGENT_MAX_SECONDS_ITERATION=600
# 单轮总 tool call 上限与单步 tool call 上限
AGENT_MAX_TOOL_CALLS=320
AGENT_MAX_TOOL_CALLS_PER_STEP=8
# 连续无进展多少步后停止
AGENT_MAX_NO_PROGRESS_STEPS=5
# Reviewer / 构建 / 启动失败的工具回修轮数
AGENT_REPAIR_MAX_ROUNDS=2
# 小于该字符数的项目直接注入全文；单文件注入上限
AGENT_CONTEXT_INLINE_CHARS=40000
AGENT_CONTEXT_FILE_CHARS=12000
# 工具步骤视图（读文件快照 / grep / 构建日志等）保留最近 N 轮，并限制每个项目的
# payload 总字节数；每次生成前后清理旧视图，步骤行本身保留。
EXECUTION_VIEW_KEEP_RUNS=20
EXECUTION_VIEW_MAX_BYTES=20000000

# Generated project runtime
# 同时运行的生成项目后端数量（LRU 淘汰）
MAX_RUNNING_APPS=2
# 单个生成后端的内存上限（Linux RLIMIT_AS，0 表示不限制）
GENERATED_APP_MEMORY_MB=256
# 生成后端启动等待秒数
RUNTIME_START_TIMEOUT=20
# 预览构建超时秒数
FRONTEND_BUILD_TIMEOUT=120
# 构建前跑 tsc --noEmit；能捕获错误的组件 props / 三方库 API。设为 0 可关闭。
FRONTEND_TYPECHECK=1
FRONTEND_TYPECHECK_TIMEOUT=60

# Optional overrides
# DATA_DIR=/app/data
# PREVIEW_NODE_MODULES=/opt/preview/node_modules

# ---------------------------------------------------------------------------
# Accounts / sessions / email
# ---------------------------------------------------------------------------
# 配置分三层，优先级从高到低：
#   进程/容器环境变量 > backend/.env.{APP_ENV} > backend/.env（本文件）
#
# 本文件只放两个环境共享的密钥与模型配置。环境相关配置请放到：
#   backend/.env.local      本地开发（APP_ENV=local，默认）
#   backend/.env.production 线上部署（Docker Compose 设置 APP_ENV=production）
# 模板见 .env.local.example / .env.production.example。
#
# 注意：APP_ENV 需要由进程环境提供，不要写进 .env（它在加载配置文件之前读取）。

# Public origin used by verification/reset links and the OAuth callback.
# 留空 = 使用当前请求的 origin（本地开发推荐，Vite 会保留 5173 的 Host）。
# 生产示例：PUBLIC_BASE_URL=https://hajimi.site
PUBLIC_BASE_URL=

# Local HTTP development: 0/off. Production HTTPS: 1/on.
# 具体值放 .env.local / .env.production，默认按本地处理。
# AUTH_COOKIE_SECURE=0
# AUTH_SESSION_DAYS=30
# AUTH_VERIFY_TTL_HOURS=24
# AUTH_RESET_TTL_MINUTES=60

# One-click demo login. Disable for a real deployment.
# AUTH_DEMO_QUICK_LOGIN=1
AUTH_DEMO_PASSWORD=AtomsDemo2026
# SMTP 未配置时开发模式自动在页面展示验证/重置链接。
# 设为 1 可强制开启（仅本地演示），设为 0 可强制关闭。
# AUTH_DEV_LINKS=0

# Google OAuth (Authorization Code flow). Requires an HTTPS redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 留空 = {PUBLIC_BASE_URL}/api/auth/google/callback（本地/线上各自推导）
# 如需覆盖再填写完整地址；Google Console 中两个回调地址都要登记。
# GOOGLE_REDIRECT_URI=

# QQ Mail SMTP. Password is the QQ "授权码", not the login password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_TLS=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Atoms Demo
