# 本地开发环境配置模板
#
# 使用：
#   cp backend/.env.local.example backend/.env.local
#
# 加载优先级：进程环境变量 > .env.local > .env
# 本地默认 APP_ENV=local，直接 uvicorn 启动即可，不需要额外设置。

# 对外 origin。必须指向 Vite 开发服务器（不是 8000），
# 这样邮件里的验证链接才能打开页面，Vite 再把 /api 代理给后端。
# 留空也可以：后端会从请求的 Host 推导，Vite 代理保留了原始 Host。
PUBLIC_BASE_URL=http://127.0.0.1:5173

# 留空 = {PUBLIC_BASE_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# 本地走 HTTP，Cookie 不能带 Secure。
AUTH_COOKIE_SECURE=0

# 演示用快捷登录。
AUTH_DEMO_QUICK_LOGIN=1
AUTH_DEMO_PASSWORD=AtomsDemo2026

# 共享 .env 已配置 SMTP 时，邮件仍会真实发送；设为 1 可同时在页面上
# 直接拿到验证/重置链接，方便本地调试。只想用开发模式可保持 1。
AUTH_DEV_LINKS=1
