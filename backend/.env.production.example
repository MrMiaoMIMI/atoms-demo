# 线上环境配置模板
#
# 使用：在服务器上复制为 backend/.env.production（不要提交）。
# Docker Compose 会设置 APP_ENV=production，并通过 env_file 加载本文件。
#
# 加载优先级：进程环境变量 > .env.production > .env

# 线上对外域名。显式填写，避免依赖反向代理是否正确透传 Host。
PUBLIC_BASE_URL=https://hajimi.site

# 留空 = {PUBLIC_BASE_URL}/api/auth/google/callback
# Google Console 中需要登记：
#   http://127.0.0.1:5173/api/auth/google/callback（本地）
#   https://hajimi.site/api/auth/google/callback（线上）
GOOGLE_REDIRECT_URI=

# 线上为 HTTPS，Cookie 必须带 Secure。
AUTH_COOKIE_SECURE=1

# 正式对外部署建议关闭快捷登录；面试演示站点需要保留时改为 1。
AUTH_DEMO_QUICK_LOGIN=0

# 关闭开发模式链接：验证/重置链接只通过邮件发送。
AUTH_DEV_LINKS=0
